# Supabase → Project Settings → API Keys. Both are safe to expose in the browser;
# Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Assistant (server only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Clopar in Telegram (server only). From @BotFather. Also needs SUPABASE_SECRET_KEY below.
TELEGRAM_BOT_TOKEN=

# Billing (server only). Prices come from the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SECRET_KEY=
STRIPE_PRICE_LIFE_MONTH=
STRIPE_PRICE_LIFE_YEAR=
STRIPE_PRICE_PLUS_MONTH=
STRIPE_PRICE_PLUS_YEAR=
STRIPE_PRICE_TOGETHER_MONTH=
STRIPE_PRICE_TOGETHER_YEAR=

# Voice spike: ElevenLabs speaks, OpenAI Realtime still listens and thinks. Leave VOICE_TTS empty to keep the OpenAI voice.
VOICE_TTS=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# ElevenAgents voice (replaces OpenAI Realtime for voice when set; Realtime stays the fallback if it cannot open).
# The key needs Text to Speech and ElevenAgents access. The agent must have authentication on (signed URLs only),
# overrides allowed for prompt, language and first message, the languages en/de/id configured, a multilingual TTS model,
# and a client tool for every name in AGENT_TOOLS (src/lib/agent-client.ts).
VOICE_ENGINE=
ELEVENLABS_AGENT_ID=
